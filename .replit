modules = ["python-3.11", "nodejs-20"]
[agent]
expertMode = true
integrations = ["github:1.0.0", "javascript_openai_ai_integrations:2.0.0"]

[nix]
channel = "stable-25_05"
packages = ["unzip", "chromium", "nss", "cups", "alsa-lib", "atk", "cairo", "gdk-pixbuf", "gtk3", "pango", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb"]

[userenv]

[userenv.shared]
VITE_FIREBASE_API_KEY = "AIzaSyApFx6I6e7YM6WEaPcgteZ5KjqJRrHSRN0"
VITE_FIREBASE_AUTH_DOMAIN = "stashd-82e87.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID = "stashd-82e87"
VITE_FIREBASE_STORAGE_BUCKET = "stashd-82e87.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID = "933019260095"
VITE_FIREBASE_APP_ID = "1:933019260095:web:b7ead7346aaf7e7c6a220a"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Scrape proxy"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Scrape proxy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server/proxy.js"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5002
externalPort = 3002

[[ports]]
localPort = 5003
externalPort = 4200

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["bash", "-c", "NODE_ENV=production node server/proxy.js"]
