rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isListOwnerForCreate(listId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/lists/$(listId))
        && get(/databases/$(database)/documents/lists/$(listId)).data.user_id == request.auth.uid;
    }

    function isProductOwnerForCreate(productId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/products/$(productId))
        && get(/databases/$(database)/documents/products/$(productId)).data.user_id == request.auth.uid;
    }

    /** Stash lists may only contain owned products */
    function stashListAllowsProduct(listId, productId) {
      let list = get(/databases/$(database)/documents/lists/$(listId)).data;
      let product = get(/databases/$(database)/documents/products/$(productId)).data;
      return list.scope != 'stash' || product.is_owned == true;
    }

    function isOutfitOwnerForCreate(outfitId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/outfits/$(outfitId))
        && get(/databases/$(database)/documents/outfits/$(outfitId)).data.user_id == request.auth.uid;
    }

    function listCollaboratorEmails(list) {
      return list.collaborator_emails == null ? [] : list.collaborator_emails;
    }

    function isListCollaborator(list) {
      return request.auth.token.email != null
        && request.auth.token.email in listCollaboratorEmails(list);
    }

    function canAccessStandardList(listId) {
      let list = get(/databases/$(database)/documents/standard_lists/$(listId)).data;
      return isSignedIn()
        && (list.user_id == request.auth.uid
          || isListCollaborator(list)
          || list.is_shared == true);
    }

    function canEditStandardList(listId) {
      let list = get(/databases/$(database)/documents/standard_lists/$(listId)).data;
      return isSignedIn()
        && (list.user_id == request.auth.uid
          || isListCollaborator(list));
    }

    match /profiles/{userId} {
      allow read, create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /lists/{listId} {
      allow read: if (isSignedIn() && resource.data.user_id == request.auth.uid)
        || resource.data.is_shared == true;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
    }

    match /list_products/{rowId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow read: if exists(/databases/$(database)/documents/lists/$(resource.data.list_id))
        && get(/databases/$(database)/documents/lists/$(resource.data.list_id)).data.is_shared == true;

      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && isListOwnerForCreate(request.resource.data.list_id)
        && isProductOwnerForCreate(request.resource.data.product_id)
        && stashListAllowsProduct(request.resource.data.list_id, request.resource.data.product_id);

      allow update, delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn()
        && request.auth.uid == resource.data.user_id;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
    }

    match /outfits/{outfitId} {
      allow read, update, delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
    }

    match /outfit_products/{rowId} {
      allow read, delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && isOutfitOwnerForCreate(request.resource.data.outfit_id)
        && isProductOwnerForCreate(request.resource.data.product_id);
      allow update: if false;
    }

    match /standard_lists/{listId} {
      allow read: if (isSignedIn()
        && (resource.data.user_id == request.auth.uid
          || isListCollaborator(resource.data)))
        || resource.data.is_shared == true;
      allow update: if isSignedIn()
        && (resource.data.user_id == request.auth.uid
          || canEditStandardList(listId));
      allow delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
    }

    match /standard_list_items/{itemId} {
      allow read: if canAccessStandardList(resource.data.list_id);
      allow update, delete: if canEditStandardList(resource.data.list_id);
      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/standard_lists/$(request.resource.data.list_id))
        && request.resource.data.user_id == get(/databases/$(database)/documents/standard_lists/$(request.resource.data.list_id)).data.user_id
        && canEditStandardList(request.resource.data.list_id);
    }

    match /standard_list_comments/{commentId} {
      allow read: if canAccessStandardList(resource.data.list_id);
      allow delete: if isSignedIn()
        && (resource.data.user_id == request.auth.uid
          || get(/databases/$(database)/documents/standard_lists/$(resource.data.list_id)).data.user_id == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && canEditStandardList(request.resource.data.list_id);
      allow update: if false;
    }

    match /saved_link_collections/{collectionId} {
      allow read, update, delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
    }

    match /saved_links/{linkId} {
      allow read, update, delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
    }
  }
}
