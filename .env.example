# Copy to .env or .env.local and fill in (Vite reads VITE_* at build/dev time).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Used by server/proxy.js (set in hosting dashboard or shell, not required for UI-only dev).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Optional Pi residential proxy — see pi-proxy/README.md
# RESIDENTIAL_PROXY_URL=
# RESIDENTIAL_PROXY_KEY=
