# Copy to .env or .env.local and fill in (Vite reads VITE_* at build/dev time).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Required for outfit / look photo uploads (Firebase Console → Storage → Get started).
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: required when Firebase App Check enforcement is enabled for Firestore/Storage.
# Firebase Console → App Check → register the web app with reCAPTCHA v3, then paste the site key here.
# VITE_FIREBASE_APPCHECK_SITE_KEY=
# Local dev with enforcement on: set true, reload the app, copy the debug token from the browser console,
# register it under App Check → Manage debug tokens, then restart dev.
# VITE_FIREBASE_APPCHECK_DEBUG=true

# Used by server/proxy.js (set in hosting dashboard or shell, not required for UI-only dev).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# Optional: max ms for Playwright scrape step (default 65000). Render free tier is slow on heavy PDPs.
# PLAYWRIGHT_TIMEOUT_MS=90000

# Optional Pi residential proxy — see pi-proxy/README.md (no trailing slash or colon on the URL).
# RESIDENTIAL_PROXY_URL=
# RESIDENTIAL_PROXY_KEY=

# Production only: public origin where `node server/proxy.js` runs (see docs/VERCEL_PRODUCTION.md). Omit in local dev (Vite proxies /api).
# VITE_SCRAPE_API_URL=https://your-api-host.example.com
